{
  "name": "war-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "geo": "node scripts/build-geo.mjs",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.1"
  }
}
